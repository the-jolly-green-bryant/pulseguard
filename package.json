{
  "name": "pulseguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create pulseguard",
    "db:migrate:local": "wrangler d1 execute pulseguard --local --file services/monitor-worker/schema.sql",
    "db:migrate:remote": "wrangler d1 execute pulseguard --remote --file services/monitor-worker/schema.sql",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
