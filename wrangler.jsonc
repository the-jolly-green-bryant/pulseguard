{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulseguard",
  "main": "services/monitor-worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "routes": [{ "pattern": "pulseguard.bryantjames.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/health", "/v1/*"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pulseguard", "database_id": "9fe822d6-1dd2-4413-a710-2f919d2e7c11" }],
  "observability": { "enabled": true }
}
