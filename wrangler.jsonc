{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulseguard",
  "main": "services/monitor-worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "routes": [{ "pattern": "pulseguard.bryantjames.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/health", "/v1/*", "/hooks/*", "/auth/*", "/api/*"] },
  "vars": {
    "ALLOWED_GOOGLE_EMAILS": "bryant@bryantjames.com",
    "AWS_SES_ALERT_URL": "https://fukwvz4vxzgwzgkho3exdbq4mu0bfhel.lambda-url.us-west-2.on.aws/"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pulseguard", "database_id": "9fe822d6-1dd2-4413-a710-2f919d2e7c11" }],
  "observability": { "enabled": true }
}
